# Client-side Supabase Configuration (Public Anon Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-side Secret for Local Development / Testing
# NOTE: NOT prefixed with VITE_, so this will NEVER be bundled into client-side JS.
# In production, configure this secret in Supabase: Project Settings -> Edge Functions -> Secrets
# or run: supabase secrets set GROQ_API_KEY=your_key_here
GROQ_API_KEY=
